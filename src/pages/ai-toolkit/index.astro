---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { tools } from '../../data/ai-toolkit';
import { withBase } from '../../lib/url';

const title = 'AI Toolkit';
const lede = 'Hands-on guides and free tools for using AI in medical education.';
---
<Base title={title} description={lede}>
  <PageHead title={title} lede={lede} />

  <div class="prose">
    <p>
      Each guide walks through one task from start to finish. For background on how AI works and where it
      goes wrong, see the <a href={withBase('/ai-literacy/')}>AI literacy lectures</a>.
    </p>
  </div>

  <section class="section" aria-labelledby="tools">
    <h2 id="tools">Tools</h2>
    <ul class="projects">
      {tools.map((p) => (
        <li class="project">
          <h3 class="project__title"><a href={withBase(p.href)}>{p.title}</a></h3>
          <p class="project__desc">{p.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
